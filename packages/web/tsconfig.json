{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "noEmitOnError": true
  },
  "include": ["src/index.ts", "src/DeepFilter.ts", "src/stream.ts"]
}
